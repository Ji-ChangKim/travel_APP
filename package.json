{
  "name": "wherego-workspace",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace=@wherego/mobile run start",
    "android": "npm --workspace=@wherego/mobile run android",
    "ios": "npm --workspace=@wherego/mobile run ios",
    "web": "npm --workspace=@wherego/mobile run web",
    "mobile": "npm --workspace=@wherego/mobile run start",
    "mobile:web": "npm --workspace=@wherego/mobile run web",
    "mobile:doctor": "npm --workspace=@wherego/mobile run doctor",
    "mobile:build:web": "npm --workspace=@wherego/mobile run build:web",
    "mobile:build:apk": "npm --workspace=@wherego/mobile run build:apk",
    "mvp:check": "node --env-file-if-exists=.env.mvp scripts/check-mvp-build.mjs",
    "mvp:prepare": "node --env-file-if-exists=.env.mvp scripts/prepare-mvp.mjs",
    "mvp:bundle:android": "npm --workspace=@wherego/mobile run bundle:android",
    "api:dev": "npm --workspace=@wherego/api run dev",
    "api:build": "npm --workspace=@wherego/api run build",
    "test:foundation": "npm --workspace=@wherego/api run test",
    "test:trail:web": "playwright test",
    "test:auth": "tsx --test tests/auth/*.test.ts",
    "test:release": "node --test tests/release/*.test.mjs",
    "release:check": "node --env-file-if-exists=.env.release scripts/release-config.mjs",
    "release:config": "node --env-file-if-exists=.env.release scripts/release-config.mjs --write-worker",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "release:prepare": "node --env-file-if-exists=.env.release scripts/prepare-release.mjs",
    "test:workspace:web": "node scripts/verify-workspace-web.mjs",
    "preview:trail": "node scripts/preview-trail.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build:web": "npm --workspace=@wherego/mobile run build:web",
    "build:apk": "npm --workspace=@wherego/mobile run build:apk",
    "build:all": "npm --workspace=@wherego/mobile run build:all",
    "eas:login": "npx --yes eas-cli login",
    "eas-build-post-install": "node scripts/check-mvp-build.mjs --preview-only",
    "doctor": "npx expo-doctor",
    "test:cloud": "npm run api:build:test && node --test tests/cloud/runtime.test.mjs",
    "api:build:test": "npm --workspace=@wherego/api run build:test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^4.1.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.67.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
