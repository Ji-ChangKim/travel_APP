# .env.release로 복사한다. 비밀 값은 이 파일이나 앱 번들에 넣지 않는다.
RELEASE_ENV=staging
FLIGHT_LOOKUP_PROVIDER=kac
RELEASE_WEB_ORIGIN=https://YOUR_WEB_DOMAIN
CLOUDFLARE_PAGES_PROJECT=YOUR_PAGES_PROJECT
EXPO_PUBLIC_BACKEND=cloudflare
EXPO_PUBLIC_API_URL=https://YOUR_WORKER_DOMAIN
EXPO_PUBLIC_AUTH_WEB_REDIRECT_URL=https://YOUR_WEB_DOMAIN/auth/callback
EXPO_NO_DOTENV=1
# 앱 표시용 제한 키: Maps SDK for Android만 허용하고 패키지·서명 SHA-1을 제한한다.
# 서버용 GOOGLE_PLACES_API_KEY와 구분하며 Places·Routes는 활성화하지 않는다.
GOOGLE_MAPS_ANDROID_API_KEY=
