# .env.release로 복사하고 실제 값 입력. 저장소나 채팅에 키를 올리지 않는다.
# staging과 production은 서로 다른 Supabase / Pages 프로젝트를 사용한다.
RELEASE_ENV=staging
RELEASE_WEB_ORIGIN=https://YOUR_WEB_DOMAIN
CLOUDFLARE_PAGES_PROJECT=YOUR_PAGES_PROJECT
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_API_KEY
EXPO_PUBLIC_API_URL=https://YOUR_WORKER_DOMAIN
EXPO_PUBLIC_AUTH_WEB_REDIRECT_URL=https://YOUR_WEB_DOMAIN/auth/callback
# 빌드 시 로컬 개발용 .env가 릴리스 값을 덮어쓰지 않도록 한다.
EXPO_NO_DOTENV=1
