# 설치된 패키지와 Expo가 생성하는 파일을 제외한다.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*

# 네이티브 프로젝트는 필요할 때 Expo 설정으로 생성한다.
/android/
/ios/
/apps/mobile/android/
/apps/mobile/ios/
.kotlin/
.gradle/

# 로컬 환경 변수와 서명 파일을 저장소에서 제외한다.
.env
.env.*
!.env.example
!.env.release.example
!.env.mvp.example
.release/
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
test-results/
playwright-report/
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# 운영체제 임시 파일과 개발 로그를 제외한다.
.DS_Store
Thumbs.db
*.log
.vs/

# 보안 키 및 접근 토큰 문서
docs/98. keys/

# EAS 업로드에는 빌드 소스만 담고 로컬 검수 결과·캐시·작업 도구는 제외한다.
/outputs/
/scratch/
/_workspace/
/.idea/
/.agents/
/.codex/

# 보고서와 화면 제작 원본은 앱 실행에 쓰지 않는다. 런타임 디자인 토큰은 포함한다.
/output/
