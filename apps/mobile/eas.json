{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "autoIncrement": false,
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_BACKEND": "cloudflare",
        "EXPO_PUBLIC_API_URL": "https://tripprint-api-staging.gametps.workers.dev",
        "EXPO_PUBLIC_AUTH_WEB_REDIRECT_URL": "https://tripprint-staging.pages.dev/auth/callback"
      }
    },
    "play-internal": {
      "extends": "preview",
      "distribution": "store",
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "environment": "production",
      "autoIncrement": false
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "applicationId": "com.tripprint.app",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "play-internal-draft": {
      "android": {
        "applicationId": "com.tripprint.app",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {}
  }
}
