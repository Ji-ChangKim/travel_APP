    "hono": "^4.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@electric-sql/pglite": "^0.5.8",
    "tsx": "^4.23.15",
    "wrangler": "^4.146.0"
  }
}
