{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "expo/types"],
    "paths": {
      "@/*": ["./apps/mobile/src/*"],
      "@wherego/domain": ["./packages/domain/src/index.ts"],
      "@wherego/validation": ["./packages/validation/src/index.ts"],
      "@wherego/api-client": ["./packages/api-client/src/index.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "apps/mobile/android",
    "apps/mobile/ios",
    "apps/web"
  ],
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
