# .env.mvp에 실제 테스트 공개 값을 입력한다. EAS preview에도 별도로 등록한다.
# 관리자 키·OAuth 비밀·OCR 키·Expo 토큰은 이 파일에 넣지 않는다.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_API_KEY
EXPO_PUBLIC_API_URL=https://YOUR_STAGING_API_DOMAIN
EXPO_PUBLIC_AUTH_WEB_REDIRECT_URL=https://YOUR_TEST_WEB_DOMAIN/auth/callback
EXPO_NO_DOTENV=1
